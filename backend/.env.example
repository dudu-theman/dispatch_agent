# Copy to backend/.env and fill in. .env is gitignored.

# Required: Claude API key for the conversation agent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: browser origins allowed to call the API, comma-separated, no trailing slash.
# Defaults to the local UI (http://localhost:5173,http://127.0.0.1:5173).
# UI_ORIGINS=https://dispatch-agent.vercel.app

# Only for scripts/get_providers.py (rebuilding the provider database).
# GOOGLE_PLACES_API_KEY=...
